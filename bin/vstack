#!/usr/bin/env python3
"""vstack: run a manager's recurring writing workflows on any agent harness.

A *workflow* is one JSON file describing one recurring document as the same stages:
trigger -> gather -> diff -> write -> gate -> land -> brief -> record. vstack renders a workflow into a
single prompt and hands it to the harness you name. Skills (SKILL.md) do the writing and
checking; MCP tools do the fetching and publishing; vstack owns only the plumbing.

Subcommands
  render        print the prompt a workflow would run (no model call)
  run           render, pre-flight (check + verify-skills), execute on a harness, check the contract, record
  check         validate the workflows against the invariants
  map           print the estate (sources, writers, gates, sinks, ledgers, bots) derived from the workflows
  gen-agent     emit a harness agent template whose tool surface is exactly the connectors file
  verify-skills compare installed skill copies against a lock file
  link-skills   make every harness skill dir a symlink to one canonical dir
  gen-cron      emit crontab lines (or kirocrew cron commands) for every workflow with a trigger
  gen-mcp       emit an MCP server block for one harness from one servers file
  check-run     verify a run directory against the done-means contract (artifacts, not claims)
  retro         read the ledger for the last N days and write a dated retro page with per-workflow
                scorecard trends and two-in-a-row regression flags (no model call)
  record        stage 6 for a run dir: meta.json, scorecard.json, one runs.jsonl line (idempotent, any harness)
  reflect       stage 7: diff the landed document against draft.md 24 h and 7 d after landing, file
                proposals, mistakes and deletions, fill owner_edit_ratio (--render prints the worker prompt)

Most commands take --instance DIR (or $VSTACK_INSTANCE): the private directory holding
connectors.json, glossary.md, workflows/ and vstack.lock. With it, --connectors, --glossary and
--workflows are filled in and the lock is compared with this checkout.

Everything is plain files. No daemon, no database.
"""
import argparse, datetime as dt, hashlib, json, os, re, shlex, shutil, subprocess, sys, uuid
from pathlib import Path

HERE = Path(__file__).resolve().parent.parent
HOME = Path.home()
HARNESSES = ("claude", "codex", "kiro", "kirocrew", "print")
PRIVATE_COMPONENT_DEFAULT = "hr"


# ----------------------------------------------------------------------------- helpers
def load(p):
    with open(p) as f:
        return json.load(f)


def expand(s, env):
    """${config.x} / ${run_id} / ${harness} substitution inside strings."""
    def one(m):
        key = m.group(1)
        cur = env
        for part in key.split("."):
            if isinstance(cur, dict) and part in cur:
                cur = cur[part]
            else:
                return m.group(0)
        return str(cur)
    return re.sub(r"\$\{([a-zA-Z0-9_.]+)\}", one, s)


def slug(s):
    return re.sub(r"[^a-zA-Z0-9._-]+", "-", s).strip("-").lower()


def expand_deep(obj, env):
    if isinstance(obj, str):
        return expand(obj, env)
    if isinstance(obj, list):
        return [expand_deep(x, env) for x in obj]
    if isinstance(obj, dict):
        return {k: expand_deep(v, env) for k, v in obj.items()}
    return obj


def sha(p):
    h = hashlib.sha256()
    with open(p, "rb") as f:
        h.update(f.read())
    return h.hexdigest()


def now():
    return dt.datetime.now(dt.timezone.utc).isoformat(timespec="seconds")


def die(msg, code=1):
    print(f"vstack: {msg}", file=sys.stderr)
    sys.exit(code)


# ----------------------------------------------------------------------------- check
def check(workflows_dir, private_component):
    """Invariants. Returns list of failures (empty = pass)."""
    fails = []
    cells = {}
    for p in sorted(Path(workflows_dir).glob("*.json")):
        if p.name.endswith(".sample.json"):
            continue
        try:
            c = load(p)
        except Exception as e:  # noqa
            fails.append(f"{p.name}: not valid JSON ({e})")
            continue
        cells[c.get("id", p.stem)] = (p, c)

    for cid, (p, c) in cells.items():
        for req in ("id", "kind", "component", "sources", "sink", "ledger"):
            if req not in c:
                fails.append(f"{cid}: missing field '{req}'")
        kind = c.get("kind")
        if kind == "writer":
            if "writer" not in c or "skill" not in c["writer"]:
                fails.append(f"{cid}: writer workflow has no writer.skill")
            g = c.get("gate")
            if not g or "skill" not in g:
                fails.append(f"{cid}: writer workflow has no gate (invariant 3: every draft is gated before it lands)")
            else:
                if int(g.get("min_passes", 0)) < 2:
                    fails.append(f"{cid}: gate.min_passes must be >= 2")
                if int(g.get("max_passes", 0)) < int(g.get("min_passes", 2)):
                    fails.append(f"{cid}: gate.max_passes < min_passes")
        # invariant 2: writers never fetch. The writer skill name must not be a connector.
        for s in c.get("sources", []):
            conn = s.get("connector", s.get("role"))
            if not conn:
                fails.append(f"{cid}: source without a connector (sources are addressed by connector name, never by tool name)")
            elif "." not in conn:
                fails.append(f"{cid}: source connector '{conn}' is not namespaced (e.g. docs.read)")
        # coverage: a writer that reads one source writes from one source. Default minimum 2, the
        # workflow may raise it or require connectors (e.g. a corroboration connector) through "coverage".
        if kind == "writer":
            cov = c.get("coverage", {})
            need = int(cov.get("min_sources", 2))
            if len(c.get("sources", [])) < need:
                fails.append(f"{cid}: {len(c.get('sources', []))} source(s), coverage.min_sources is {need}")
            have = {s.get("connector", s.get("role")) for s in c.get("sources", [])}
            for r in cov.get("require_connectors", cov.get("require_roles", [])):
                if r not in have:
                    fails.append(f"{cid}: coverage.require_connectors names '{r}' but no source has that connector")
        # invariant 4: every sink records
        led = c.get("ledger", {})
        if not led.get("fields"):
            fails.append(f"{cid}: ledger.fields is empty (invariant 4: every landing records an outcome)")
        # draft_contract: every pattern must be a valid regex, so a typo cannot silently disable a rule
        dc = c.get("draft_contract", {})
        for key in ("must_match", "must_not_match"):
            for rule in dc.get(key, []):
                try:
                    re.compile(rule["pattern"])
                except (re.error, KeyError, TypeError) as e:
                    fails.append(f"{cid}: draft_contract.{key} rule is not a valid regex ({e}): {rule}")
        # invariant 5: privacy cut
        if c.get("component") == private_component:
            ws = c.get("workspace", "")
            if not ws or ws in ("default", ""):
                fails.append(f"{cid}: component '{private_component}' must name a private workspace")
            for f in led.get("fields", []):
                if re.search(r"rating|candidate|promo|salary|comp|feedback_text", f, re.I):
                    fails.append(f"{cid}: ledger field '{f}' would leak {private_component} data across the privacy cut")
        # sink must have a dry-run landing
        if "dry_run_path" not in c.get("sink", {}):
            fails.append(f"{cid}: sink has no dry_run_path (every workflow must be runnable without side effects)")

    # privacy cut across workflows: a consumer in another component may read a private ledger only
    for cid, (p, c) in cells.items():
        if c.get("kind") == "consumer":
            for s in c.get("sources", []):
                if s.get("connector", s.get("role", "")).startswith("ledger.") and s.get("component") == private_component \
                        and c.get("component") != private_component:
                    pass  # ledger lines are field-checked at write time; reading them is allowed
    # every writer loops (factory decision 19): invariant 3 above already fails a missing gate or min_passes
    # under 2, this adds the upper bound so a gate cannot loop without end
    for cid, (p, c) in cells.items():
        g = c.get("gate")
        if not isinstance(g, dict) or not g.get("skill"):
            continue
        mn, mx = int(g.get("min_passes", 0) or 0), int(g.get("max_passes", 0) or 0)
        if mx > 5 or mx < mn:
            fails.append(f"{cid}: gate.max_passes is {mx}, must be between min_passes and 5")
    return fails, cells


def derive_map(cells):
    """The estate as typed nodes and edges, derived from the workflow files. S source, C cache,
    W writer, G gate, D sink, L ledger, B bot. Printed by `vstack map`; nothing reads it back."""
    nodes, edges = {}, []
    def node(i, t, comp, label):
        nodes.setdefault(i, {"id": i, "type": t, "component": comp, "label": label})
    for cid, (p, c) in cells.items():
        comp = c.get("component", "")
        cache = f"cache.{comp}"; node(cache, "C", comp, f"{comp} evidence cache")
        for src in c.get("sources", []):
            sid = f"src.{src.get('connector', src.get('role', '?'))}"
            node(sid, "S", comp, src.get("connector", src.get("role", "?")))
            edges.append({"from": sid, "to": cache, "type": "reads", "workflow": cid})
        w = c.get("writer", {}).get("skill")
        if w:
            wid = f"w.{w}"; node(wid, "W", comp, w); edges.append({"from": cache, "to": wid, "type": "writes", "workflow": cid})
            g = c.get("gate", {}).get("skill", "validate-writing"); gid = f"g.{comp}.{g}"
            node(gid, "G", comp, g); edges.append({"from": wid, "to": gid, "type": "gates", "workflow": cid})
            sink = c.get("sink", {}); did = f"d.{cid}"
            node(did, "D", comp, f"{sink.get('connector', sink.get('role', '?'))} -> {sink.get('ref', '')}")
            edges.append({"from": gid, "to": did, "type": "lands", "workflow": cid})
            lid = f"l.{c.get('ledger', {}).get('file', cid + '.jsonl')}"
            node(lid, "L", comp, lid[2:]); edges.append({"from": did, "to": lid, "type": "records", "workflow": cid})
        bot = c.get("bot") or c.get("agent")
        if bot:
            bid = f"b.{bot}"; node(bid, "B", comp, bot)
            nodes[bid].setdefault("workflows", []).append(cid)
    return {"nodes": list(nodes.values()), "edges": edges}


def print_map(m):
    byt = {}
    for n in m["nodes"]:
        byt.setdefault(n["type"], []).append(n)
    names = {"B": "bots", "S": "sources", "C": "caches", "W": "writers", "G": "gates", "D": "sinks", "L": "ledgers"}
    for t in "BSCWGDL":
        for n in sorted(byt.get(t, []), key=lambda x: x["id"]):
            extra = f"  hosts {', '.join(n['workflows'])}" if n.get("workflows") else ""
            print(f"{t} {n['id']:<42} {n['component']:<9} {n['label']}{extra}")
    print(f"\n{len(m['nodes'])} nodes, {len(m['edges'])} edges")


# ----------------------------------------------------------------------------- skills
def skill_hash(skill_dir):
    """Hash of every file in a skill dir, order-independent."""
    h = hashlib.sha256()
    for p in sorted(Path(skill_dir).rglob("*")):
        if p.is_file():
            h.update(p.relative_to(skill_dir).as_posix().encode())
            h.update(sha(p).encode())
    return h.hexdigest()


def check_frontmatter(skill_md):
    """Parse a SKILL.md frontmatter the way a strict YAML reader does, with the standard library
    only. Returns (fields, errors). Rejects what GitHub's renderer and PyYAML reject: an unquoted
    value that contains ': ' or ' #', or that starts with a reserved indicator."""
    text = Path(skill_md).read_text(encoding="utf-8")
    lines = text.split("\n")
    errors, fields = [], {}
    if not lines or lines[0].strip() != "---":
        return fields, ["no frontmatter (first line must be ---)"]
    try:
        end = lines.index("---", 1)
    except ValueError:
        return fields, ["frontmatter never closed with ---"]
    for i, line in enumerate(lines[1:end], start=2):
        if not line.strip() or line.lstrip().startswith("#"):
            continue
        if line.startswith((" ", "\t")):
            errors.append(f"line {i}: indented continuation lines are not supported, keep each field on one line")
            continue
        key, sep, value = line.partition(":")
        if not sep or not re.fullmatch(r"[A-Za-z][A-Za-z0-9_-]*", key):
            errors.append(f"line {i}: expected 'key: value'")
            continue
        value = value.strip()
        if (value.startswith('"') and value.endswith('"')) or (value.startswith("'") and value.endswith("'")):
            fields[key] = value[1:-1]
            continue
        if value and value[0] in "[]{}&*!|>%@`":
            errors.append(f"line {i}: {key} starts with a YAML indicator {value[0]!r}, quote the value")
        if ": " in value or value.endswith(":"):
            errors.append(f"line {i}: {key} contains ': ' inside an unquoted value (mapping values are not allowed here), rewrite without the colon or quote the whole value")
        if " #" in value:
            errors.append(f"line {i}: {key} contains ' #', which starts a YAML comment, quote the value")
        fields[key] = value
    return fields, errors


def verify_skills(lock_path, dirs, names):
    """Every named skill must exist in every dir and hash identically across dirs. If a lock file
    is given, the canonical copy's SKILL.md hash must match the lock's computedHash."""
    lock = load(lock_path) if lock_path else {}
    lock_by_path = {}
    for entry in (lock.get("skills") or {}).values():
        lock_by_path[Path(entry["skillPath"]).parent.name] = entry.get("computedHash")
    fails, report = [], []
    for name in names:
        hashes = {}
        for d in dirs:
            p = Path(d).expanduser() / name
            if not p.exists():
                fails.append(f"{name}: missing in {d}")
                continue
            hashes[str(d)] = skill_hash(p)
        if len(set(hashes.values())) > 1:
            fails.append(f"{name}: copies differ across {', '.join(hashes)}")
        canon = Path(dirs[0]).expanduser() / name / "SKILL.md"
        if canon.exists():
            fields, errs = check_frontmatter(canon)
            for e in errs:
                fails.append(f"{name}: SKILL.md frontmatter {e}")
            if fields.get("name") != name:
                fails.append(f"{name}: SKILL.md frontmatter name is {fields.get('name')!r}, must equal the directory name")
        if name in lock_by_path and canon.exists():
            if sha(canon) != lock_by_path[name]:
                report.append(f"{name}: SKILL.md differs from lock (local edits or newer upstream)")
        report.append(f"{name}: {'ok' if name not in [f.split(':')[0] for f in fails] else 'FAIL'} in {len(hashes)} dirs")
    return fails, report


def link_skills(canonical, targets, names, backup_root):
    canonical = Path(canonical).expanduser()
    done = []
    for t in targets:
        t = Path(t).expanduser()
        t.mkdir(parents=True, exist_ok=True)
        for name in names:
            src = canonical / name
            dst = t / name
            if not src.exists():
                die(f"canonical skill missing: {src}")
            if dst.is_symlink():
                if dst.resolve() == src.resolve():
                    done.append(f"{dst} already -> {src}")
                    continue
                dst.unlink()
            elif dst.exists():
                bk = Path(backup_root).expanduser() / t.name / name
                bk.parent.mkdir(parents=True, exist_ok=True)
                if bk.exists():
                    shutil.rmtree(bk)
                shutil.move(str(dst), str(bk))
                done.append(f"{dst}: real copy moved to {bk}")
            os.symlink(src, dst)
            done.append(f"{dst} -> {src}")
    return done


# ----------------------------------------------------------------------------- render
PROMPT = """# Workflow run: {id} ({kind}) on {harness}{dry}

You are executing one workflow. Follow the stages in order. Do not skip the gate.
Work only inside the run directory for outputs: {run_dir}
All paths below are absolute. Read files with your file-reading tool; never guess their contents.

## 0. Rules that apply to every stage
- Writers never fetch: the writing skill receives evidence you gathered, it does not call tools.
- Nothing lands ungated: the draft reaches its sink only after the gate loop passes.
- Record or it did not happen: the final stage appends one ledger line and one result file.
- Evidence only: no metric, name, date or link that is not in the gathered evidence.
- Organisation vocabulary comes from the glossary below, not from memory.
- Runner contract: stage 1 uses read-only tools (read, list, search, get). The only write outside
  the run directory is stage 5, through the one sink connector named there. Never post, send, react,
  mark as read, or create anything anywhere else, in any stage, for any reason.
- Rationalizations are listed in {skills_dir}/leadership-writing/rationalizations.md. If you
  notice yourself reaching for one, do what its rebuttal says.

## Done means
This run is complete only when every file below exists in {run_dir}; `vstack check-run` reads
them and marks the run `contract_unmet` otherwise. A claim in your reply is not evidence.
- evidence.json with a `sources` list (connector, status, item count) and `evidence_hash`
- diff.md
- draft.md whose first line after the title is `Sources: used ...; unavailable ...`
- gate.md whose first line is `passes: N` with N >= {min_passes}
- brief.md, three lines (see stage 5b)
- result.json, and one appended ledger line
{draft_contract_lines}
## 1. GATHER{gather_mode}
{gather}

Write the gathered evidence as JSON to: {run_dir}/evidence.json

## 2. DIFF
Read {cache_path}/last-evidence.json if it exists and list, in {run_dir}/diff.md, what changed
since the last run (new items, changed dates or statuses, removed items). If the file does not
exist write "first run" to diff.md. Then copy evidence.json to {cache_path}/last-evidence.json.

## 3. WRITE
Read these files first, in this order, and apply every rule in them:
- {skills_dir}/leadership-writing/house-rules.md
- {skills_dir}/{writer_skill}/SKILL.md (and every file it tells you to read next to it)
Glossary (your organisation's words; overrides the skill's defaults; use them verbatim):
{org_profile}

Produce the document the skill describes from evidence.json{writer_inputs}. Its first line after
the title is the sources header, built from evidence.json: `Sources: used <connectors that returned
items>; unavailable <connectors that were unmapped, skipped or empty>` (write `none` for an empty side).
A thin run must be visible to the reader, never papered over. Save it to {run_dir}/draft.md.

## 4. GATE (validation loop)
Read {skills_dir}/{gate_skill}/SKILL.md and {skills_dir}/{gate_skill}/checklist.md.
Apply the gate to draft.md with doc type `{doc_type}`. Fix every quoted failure, re-run.
Rules: minimum {min_passes} passes, maximum {max_passes} passes, stop when a pass has zero blockers
and zero majors{coverage}. A fix may never invent a fact; an unfixable blocker goes under a closing
`**Known Gaps**` note in draft.md. Write the last pass report to {run_dir}/gate.md with the pass
count on its first line as `passes: N`. Verification before completion: every rule the report
marks passed names what it checked (a quoted span or a count), and every failure quotes the
offending text. "Verified" with nothing quoted is itself a failure.

## 4b. CONTRACT CHECK (before anything leaves the run directory)
Run with your shell: `{vstack_bin} check-run {run_dir} --workflow {workflow_file}`
It must print `contract: MET`. If it lists unmet items, fix draft.md (never the rule) and re-run
until it is met. A draft that fails this check is never landed.

## 5. LAND
{land}

## 5b. BRIEF
Write {run_dir}/brief.md: exactly three lines a busy reader decides from without opening the
draft. Line 1: what landed (document type, subject, one status word). Line 2: the one fact that
most needs the reader's attention, with its source. Line 3: where the draft is (the landed path
or id) and what the reader must do (send, approve, or nothing).

## 6. RECORD
Append exactly one JSON line to {ledger_path} with these fields, taken from the final draft and
this run: {ledger_fields}, plus run_id="{run_id}", workflow="{id}", harness="{harness}",
dry_run={dry_json}, no_publish={nopub_json}, landed_at (ISO time), gate_passes (from gate.md).
Then write {run_dir}/result.json: {{"status": "ok" | "known_gaps" | "failed", "gate_passes": N,
"draft": "{run_dir}/draft.md", "brief": "{run_dir}/brief.md", "landed": <where the draft went>}}.
Then run with your shell: `{vstack_bin} record {run_dir} --workflow {workflow_file}`
It writes meta.json and scorecard.json in the run directory, appends this run's line to the shared
runs ledger and runs the workflow's record.post_record command (the dashboard render). A run that
skips this line is invisible to `vstack retro` and the dashboard.
Reply with the single line: VSTACK_RESULT <status> passes=<N>
"""

SECOND_OPINION = """# Second opinion on a draft ({harness})

You are an independent critic. You did not write this draft and you must not edit it.
Read {skills_dir}/leadership-writing/house-rules.md, {skills_dir}/{gate_skill}/SKILL.md and
{skills_dir}/{gate_skill}/checklist.md. Read {run_dir}/draft.md and {run_dir}/evidence.json.

Run the gate in evaluate mode on draft.md with doc type `{doc_type}`, and additionally check
every number, date, name and link in the draft against evidence.json.

Rules for your report: a finding counts only when you quote the exact offending text and, for
an evidence mismatch, the evidence value beside it. A concern without a quote is a note, not a
finding. Do not repeat the primary gate's style; look for what it would miss: a claim the
evidence does not support, a status stronger than its fact, a missing Known Gap.

Write {run_dir}/gate-second.md: first line `findings: N`, then each finding as
`[blocker|major|minor] rule -> "offending" -> evidence or fix`, then a `notes:` section.
Reply with the single line: VSTACK_SECOND findings=<N>
"""


def verify_contract(run_dir, cell):
    """The done-means contract: which required artifacts are missing or malformed in a run dir."""
    run_dir = Path(run_dir)
    missing = []
    writer = cell.get("writer", {}).get("skill")
    ev = run_dir / "evidence.json"
    if not ev.exists():
        missing.append("evidence.json")
    else:
        try:
            e = load(ev)
            if "sources" not in e or "evidence_hash" not in e:
                missing.append("evidence.json lacks sources or evidence_hash")
        except Exception:
            missing.append("evidence.json is not valid JSON")
    if not (run_dir / "diff.md").exists():
        missing.append("diff.md")
    draft = run_dir / "draft.md"
    if not draft.exists():
        missing.append("draft.md")
    else:
        nonempty = [l for l in draft.read_text().splitlines() if l.strip()]
        # a promo doc opens with its document header and closes with the Sources line (template.md),
        # every other genre carries it in the first six lines
        window = nonempty[:6] + nonempty[-6:] if writer == "write-promo-doc" else nonempty[:6]
        # a promo doc writes `Sources used: ... Sources unavailable: ...` (no semicolon, D36),
        # every other genre `Sources: used ...; unavailable ...`
        if not any(re.match(r"sources( used)?:", l.lower()) for l in window):
            missing.append("draft.md has no `Sources: used ...; unavailable ...` header line" + (" (or `Sources used: ... Sources unavailable: ...` in the first or last six lines for a promo doc)" if writer == "write-promo-doc" else ""))
    gate = run_dir / "gate.md"
    min_passes = int(cell.get("gate", {}).get("min_passes", 2))
    if not gate.exists():
        missing.append("gate.md")
    else:
        m = re.match(r"\s*passes:\s*(\d+)", gate.read_text())
        if not m:
            missing.append("gate.md first line is not `passes: N`")
        elif int(m.group(1)) < min_passes:
            missing.append(f"gate.md reports {m.group(1)} passes, workflow requires {min_passes}")
    brief = run_dir / "brief.md"
    if not brief.exists():
        missing.append("brief.md")
    else:
        n = len([l for l in brief.read_text().splitlines() if l.strip()])
        if n != 3:
            missing.append(f"brief.md has {n} non-empty lines, expected 3")
    if not (run_dir / "result.json").exists():
        missing.append("result.json")
    if draft.exists():
        missing += check_draft_contract(draft.read_text(), cell.get("draft_contract", {}))
        if writer == "write-promo-doc":
            missing += check_promo_lint(draft)
    return missing


def check_promo_lint(draft):
    """The countable promo-doc rules (scripts/promo-lint.py, beside this file's parent) run on the
    draft of every workflow whose writer is write-promo-doc, the same way check_draft_contract does:
    a failing line marks the run contract_unmet. The readiness table is gap-analysis.md in the run
    directory. The lint is absent when the engine runs from an install that did not ship scripts/."""
    lint = Path(__file__).resolve().parent.parent / "scripts" / "promo-lint.py"
    if not lint.exists():
        return [f"promo-lint.py not found at {lint}, the writer is write-promo-doc"]
    r = subprocess.run([sys.executable, str(lint), str(draft)], capture_output=True, text=True)
    if r.returncode == 0:
        return []
    lines = [l for l in r.stdout.splitlines() if l and not l.startswith(("promo-lint:", "warning "))]
    return [f"promo-lint {l}" for l in lines]


def check_draft_contract(text, contract):
    """Shape rules the workflow pins on draft.md: `must_match` regexes that each have to hit at
    least once, `must_not_match` regexes that may not hit at all. Each rule is {pattern, why}.
    This is how a template contract becomes enforced instead of remembered: a draft whose table
    header or wording drifts from the agreed shape marks the run contract_unmet before it lands."""
    unmet = []
    for rule in contract.get("must_match", []):
        if not re.search(rule["pattern"], text, re.M):
            unmet.append(f"draft.md does not match /{rule['pattern']}/: {rule.get('why', '')}".rstrip(": "))
    for rule in contract.get("must_not_match", []):
        m = re.search(rule["pattern"], text, re.M)
        if m:
            unmet.append(f"draft.md matches forbidden /{rule['pattern']}/ at `{m.group(0)[:60]}`: {rule.get('why', '')}".rstrip(": "))
    return unmet


def render(cell, tools, org_profile_text, harness, dry_run, run_dir, run_id, skills_dir, cache_root, ledger_root, fixture=None, no_publish=False, workflow_file=None):
    env = {"config": cell.get("config", {}), "run_id": run_id, "harness": harness, "run_dir": str(run_dir)}
    cell = expand_deep(cell, env)
    roles = tools.get("connectors", tools.get("roles", {}))

    def tool_for(role):
        t = roles.get(role)
        if not t:
            return f"(no tool mapped for connector {role}; report this as a gap and continue)"
        return f"MCP server `{t['server']}`, tool `{t['tool']}`" + (f" ({t['notes']})" if t.get("notes") else "")

    if dry_run and fixture:
        gather_mode = " (dry run: sample evidence instead of live sources)"
        gather = f"Read the sample evidence {fixture} and treat its contents as the gathered evidence. Do not call any fetching tool."
    else:
        lines = []
        for s in cell["sources"]:
            conn = s.get("connector", s.get("role"))
            if no_publish and conn.endswith(".corroborate"):
                lines.append(f"- connector `{conn}` -> SKIPPED in no-publish mode (it would send a message); record it as unmapped")
                continue
            lines.append(f"- connector `{conn}` -> {tool_for(conn)}; ref: {s.get('ref', '')}; {s.get('notes', '')}".rstrip("; "))
        gather = "Cache-first: if {cache}/last-evidence.json is newer than {ttl} hours, reuse it. Otherwise fetch:\n".format(
            cache=f"{cache_root}/{slug(cell.get('cache', {}).get('key', cell['id']))}", ttl=cell.get("cache", {}).get("ttl_hours", 0)) + "\n".join(lines)
        gather_mode = ""
    sink = cell["sink"]
    if dry_run or no_publish:
        why = "Dry run" if dry_run else "No-publish run (live sources, file landing)"
        land = (f"{why}: do NOT call any publishing, posting, drafting or messaging tool (no chat posts or drafts, no mail sends or drafts, "
                f"no assistant queries that send a message). Copy draft.md to {run_dir}/{Path(sink['dry_run_path']).name} and treat that path as 'landed'.")
    else:
        sconn = sink.get("connector", sink.get("role"))
        land = f"Deliver draft.md via connector `{sconn}` -> {tool_for(sconn)}; target: {sink.get('ref', '')}. " \
               f"Land it as a DRAFT the owner must send or approve; never send on their behalf. Record the returned id or URL."
    gate = cell.get("gate", {})
    cov = f", coverage >= {gate['coverage_bar']}%" if gate.get("coverage_bar") else ""
    writer_inputs = ""
    if cell.get("writer", {}).get("extra_inputs"):
        writer_inputs = " and " + ", ".join(cell["writer"]["extra_inputs"])
    dc = cell.get("draft_contract", {})
    dc_lines = ""
    if dc.get("must_match") or dc.get("must_not_match"):
        dc_lines = "- draft.md shape rules (checked by regex, a miss marks the run contract_unmet):\n"
        for r in dc.get("must_match", []):
            dc_lines += f"  - MUST contain /{r['pattern']}/ ({r.get('why', '')})\n"
        for r in dc.get("must_not_match", []):
            dc_lines += f"  - MUST NOT contain /{r['pattern']}/ ({r.get('why', '')})\n"
    return PROMPT.format(
        id=cell["id"], kind=cell["kind"], harness=harness, dry=" [DRY RUN]" if dry_run else (" [NO-PUBLISH]" if no_publish else ""),
        run_dir=run_dir, gather_mode=gather_mode, gather=gather, draft_contract_lines=dc_lines,
        vstack_bin=str(Path(__file__).resolve()), workflow_file=workflow_file or "<workflow.json>",
        cache_path=f"{cache_root}/{slug(cell.get('cache', {}).get('key', cell['id']))}",
        skills_dir=skills_dir, writer_skill=cell.get("writer", {}).get("skill", "(none)"),
        org_profile=org_profile_text.strip() or "(defaults from the leadership-writing skill's glossary.md)",
        writer_inputs=writer_inputs,
        gate_skill=gate.get("skill", "validate-writing"), doc_type=gate.get("doc_type", "passage"),
        min_passes=gate.get("min_passes", 2), max_passes=gate.get("max_passes", 5), coverage=cov,
        land=land, ledger_path=f"{ledger_root}/{cell.get('ledger', {}).get('file', cell['id'] + '.jsonl')}",
        ledger_fields=", ".join(cell.get("ledger", {}).get("fields", [])),
        run_id=run_id, dry_json="true" if dry_run else "false", nopub_json="true" if no_publish else "false",
    )


# ----------------------------------------------------------------------------- harness
def harness_cmd(harness, prompt_file, run_dir, agent=None, model=None):
    p = str(prompt_file)
    if harness == "claude":
        cmd = ["claude", "-p", "--output-format", "text", "--permission-mode", "acceptEdits",
               "--allowedTools", "Read", "Write", "Edit", "Glob", "Grep", "Bash(mkdir:*)", "Bash(cp:*)", "Bash(cat:*)"]
        if model:
            cmd += ["--model", model]
        return cmd, open(prompt_file).read()
    if harness == "codex":
        cmd = ["codex", "exec", "--skip-git-repo-check", "-C", str(run_dir), "-s", "workspace-write"]
        if model:
            cmd += ["-m", model]
        return cmd, open(prompt_file).read()
    if harness == "kiro":
        # kiro-cli 3.x denies any tool not named in --trust-tools and the internal names differ by
        # version (fs_read vs read, fs_append, list_directory). A workflow runs against local files and
        # the agent's own MCP config, so trusting all tools is the predictable choice; scope what the
        # agent CAN reach through --agent instead.
        cmd = ["kiro-cli", "chat", "--no-interactive", "--trust-all-tools"]
        if agent:
            cmd += ["--agent", agent]
        return cmd + [open(prompt_file).read()], None
    if harness == "kirocrew":
        # Native path: a one-shot scheduled job, optionally bound to a Bot (its memory, its
        # workspace). From inside a Kiro Crew session use the cron_add MCP tool with the rendered
        # prompt instead; from a shell the CLI form below does the same.
        name = f"vstack {run_dir.name}"
        cmd = ["kirocrew", "cron", "add", name, open(prompt_file).read(), "--at", "in 1 minute", "--approval-mode", "auto"]
        if agent:
            cmd += ["--agent", agent]
        return cmd, None
    die(f"unknown harness {harness}")


def apply_instance(args):
    """--instance DIR (or $VSTACK_INSTANCE) fills --connectors and --glossary from the instance
    layout (connectors*.json, glossary*.md, one of each) unless given explicitly, and compares
    vstack.lock with this checkout."""
    inst = getattr(args, "instance", None) or os.environ.get("VSTACK_INSTANCE")
    if not inst:
        return
    d = Path(inst).expanduser()
    if not d.is_dir():
        die(f"instance directory not found: {d}")

    def one(pattern, attr):
        if getattr(args, attr, None):
            return
        hits = sorted(d.glob(pattern))
        if len(hits) == 1:
            setattr(args, attr, str(hits[0]))
        elif len(hits) > 1:
            die(f"instance {d} has {len(hits)} files matching {pattern}; pass --{attr.replace('_', '-')} explicitly")
    one("connectors*.json", "tools")
    one("glossary*.md", "org_profile")
    lock = d / "vstack.lock"
    if lock.exists():
        pinned = lock.read_text().split()[-1] if lock.read_text().split() else ""
        head = subprocess.run(["git", "-C", str(HERE), "rev-parse", "--short", "HEAD"], capture_output=True, text=True).stdout.strip()
        if pinned and head and not (head.startswith(pinned) or pinned.startswith(head)):
            print(f"vstack: warning: instance pins vstack {pinned}, this checkout is {head} (re-run a dry run, then move the pin)", file=sys.stderr)


def run(args):
    apply_instance(args)
    cell_path = Path(args.cell)
    cell = load(cell_path)
    tools = load(args.tools) if args.tools else {"roles": {}}
    org_profile_text = Path(args.org_profile).read_text() if args.org_profile else ""
    run_id = dt.datetime.now().strftime("%Y%m%d-%H%M%S") + "-" + uuid.uuid4().hex[:6]
    run_dir = Path(args.run_root).expanduser() / cell["id"] / f"{args.harness}-{run_id}"
    run_dir.mkdir(parents=True, exist_ok=True)
    skills_dir = str(Path(args.skills_dir).expanduser())
    cache_root = str(Path(args.cache_root).expanduser())
    ledger_root = str(Path(args.ledger_root).expanduser())
    Path(cache_root, slug(expand(cell.get("cache", {}).get("key", cell["id"]), {"config": cell.get("config", {})}))).mkdir(parents=True, exist_ok=True)
    Path(ledger_root).mkdir(parents=True, exist_ok=True)

    # pre-flight
    fails, _ = check(cell_path.parent, args.private_component)
    fails = [f for f in fails if f.startswith(cell["id"] + ":")]
    if fails:
        for f in fails:
            print("  invariant:", f)
        die("pre-flight failed (invariants)")
    needed = [cell.get("writer", {}).get("skill"), cell.get("gate", {}).get("skill"), "leadership-writing"]
    needed = [n for n in needed if n]
    sfails, _ = verify_skills(args.skills_lock, [skills_dir] + args.extra_skill_dirs, needed)
    if sfails:
        for f in sfails:
            print("  skills:", f)
        die("pre-flight failed (skills)")

    fixture = args.fixture or ((cell.get("sample_evidence") or cell.get("fixture")) if args.dry_run else None)
    if args.dry_run and not fixture and cell_path.with_name(cell_path.stem + ".sample.json").exists():
        fixture = str(cell_path.with_name(cell_path.stem + ".sample.json").resolve())
    if fixture:
        fixture = str((cell_path.parent / fixture).resolve()) if not Path(fixture).is_absolute() else fixture
    if args.dry_run and not fixture:
        die(f"dry run needs sample evidence: put {cell_path.stem}.sample.json beside the workflow or pass --sample")
    shown = args.harness if args.cmd == "run" else (args.harness or "print")
    prompt = render(cell, tools, org_profile_text, shown, args.dry_run, run_dir, run_id, skills_dir, cache_root, ledger_root, fixture, no_publish=args.no_publish, workflow_file=str(cell_path.resolve()))
    prompt_file = run_dir / "prompt.md"
    prompt_file.write_text(prompt)
    meta = {"run_id": run_id, "workflow": cell["id"], "harness": args.harness, "dry_run": args.dry_run, "no_publish": args.no_publish,
            "started": now(), "prompt": str(prompt_file), "run_dir": str(run_dir)}
    if args.cmd == "render" or args.harness == "print":
        print(prompt)
        return 0
    cmd, stdin = harness_cmd(args.harness, prompt_file, run_dir, agent=args.agent, model=args.model)
    (run_dir / "command.txt").write_text(" ".join(shlex.quote(c) if len(c) < 200 else "<prompt>" for c in cmd))
    t0 = dt.datetime.now()
    with open(run_dir / "stdout.log", "w") as out:
        proc = subprocess.run(cmd, input=stdin, stdout=out, stderr=subprocess.STDOUT, text=True, timeout=args.timeout)
    meta.update({"exit": proc.returncode, "seconds": round((dt.datetime.now() - t0).total_seconds(), 1), "finished": now()})
    result_file = run_dir / "result.json"
    if result_file.exists():
        try:
            meta["result"] = load(result_file)
        except Exception:
            meta["result"] = {"status": "unparseable"}
    elif args.harness == "kirocrew":
        meta["result"] = {"status": "scheduled", "note": "kirocrew runs asynchronously; result.json appears when the job finishes"}
    else:
        meta["result"] = {"status": "failed", "note": "no result.json written"}
    # done-means contract: the run dir, not the model's reply, decides
    if args.harness != "kirocrew":
        unmet = verify_contract(run_dir, cell)
        meta["contract"] = {"met": not unmet, "unmet": unmet}
        if unmet and meta["result"].get("status") in ("ok", "known_gaps"):
            meta["result"]["claimed_status"] = meta["result"]["status"]
            meta["result"]["status"] = "contract_unmet"
    # second opinion: an independent critic on another harness, findings recorded, never edits
    second = args.second_opinion or cell.get("gate", {}).get("second_opinion")
    if second and args.harness != "kirocrew" and (run_dir / "draft.md").exists():
        gate = cell.get("gate", {})
        sprompt = SECOND_OPINION.format(harness=second, skills_dir=skills_dir, run_dir=run_dir,
                                        gate_skill=gate.get("skill", "validate-writing"), doc_type=gate.get("doc_type", "passage"))
        (run_dir / "prompt-second.md").write_text(sprompt)
        scmd, sstdin = harness_cmd(second, run_dir / "prompt-second.md", run_dir, agent=None, model=None)
        with open(run_dir / "stdout-second.log", "w") as out:
            sproc = subprocess.run(scmd, input=sstdin, stdout=out, stderr=subprocess.STDOUT, text=True, timeout=args.timeout)
        g2 = run_dir / "gate-second.md"
        m2 = re.match(r"\s*findings:\s*(\d+)", g2.read_text()) if g2.exists() else None
        meta["second_opinion"] = {"harness": second, "exit": sproc.returncode,
                                  "findings": int(m2.group(1)) if m2 else None, "report": str(g2) if g2.exists() else None}
    (run_dir / "meta.json").write_text(json.dumps(meta, indent=2))
    if args.harness != "kirocrew":
        meta, _ = record_run(run_dir, cell, ledger_root, harness=args.harness, post_record=(cell.get("record") or {}).get("post_record"))
    else:
        # the worker appends the runs.jsonl line itself at stage 6 (`vstack record`), so an async run is not counted twice
        pass
    print(json.dumps(meta, indent=2))
    return 0 if meta["result"].get("status") in ("ok", "known_gaps", "scheduled") else 2


def check_run(args):
    run_dir = Path(args.run_dir).expanduser()
    meta = load(run_dir / "meta.json") if (run_dir / "meta.json").exists() else {}
    # Resolve the workflow so its gate.min_passes and draft_contract apply: --workflow wins, then
    # <instance>/workflows/<run_dir parent name>.json (runs live under runs/<workflow>/<harness>-<id>).
    cell = None
    wf = getattr(args, "workflow", None)
    if not wf and getattr(args, "instance", None):
        cand = Path(args.instance).expanduser() / "workflows" / f"{run_dir.parent.name}.json"
        if cand.exists():
            wf = str(cand)
    if wf:
        cell = load(Path(wf).expanduser())
        cell = expand_deep(cell, {"config": cell.get("config", {})})
    if cell is None:
        cell = {"gate": {"min_passes": args.min_passes}}
        print("note: no workflow resolved (pass --workflow or --instance), checking the generic contract only")
    unmet = verify_contract(run_dir, cell)
    for u in unmet:
        print("  unmet:", u)
    wname = cell.get("id") or meta.get("workflow", meta.get("cell", "?"))
    print("contract:", "MET" if not unmet else f"{len(unmet)} item(s) unmet", f"(workflow {wname}, harness {meta.get('harness', run_dir.name.split('-')[0])})")
    return 1 if unmet else 0


def retro(args):
    """Read the ledger for the last N days and write a dated retro page: per cell, runs, failures,
    contract misses, gate passes, second-opinion findings, and recurring Known Gaps. No model call.
    This is the /correct discipline applied to the estate: a class that recurs gets an enforcer."""
    rows = runs_from_ledger(args.ledger_root, days=args.days)
    by_cell = {}
    for m in rows:
        by_cell.setdefault(m.get("workflow", m.get("cell", "?")), []).append(m)
    gaps = {}
    for m in rows:
        d = Path(m.get("run_dir", "")) / "draft.md"
        if d.exists():
            text = d.read_text()
            if "**Known Gaps**" in text or "Known Gaps" in text:
                tail = text.rsplit("Known Gaps", 1)[1]
                for l in tail.splitlines()[1:8]:
                    l = l.strip(" -*")
                    if len(l) > 12:
                        gaps[l[:120]] = gaps.get(l[:120], 0) + 1
    out = [f"# Retro {dt.date.today().isoformat()} (last {args.days} days, {len(rows)} runs)", ""]
    out += ["| Workflow | Runs | ok | known_gaps | failed | contract unmet | avg gate passes | second-opinion findings |", "|---|---|---|---|---|---|---|---|"]
    for cell, ms in sorted(by_cell.items()):
        st = [m.get("result", {}).get("status") for m in ms]
        passes = [m.get("result", {}).get("gate_passes") for m in ms if isinstance(m.get("result", {}).get("gate_passes"), int)]
        unmet = sum(1 for m in ms if m.get("contract") and not m["contract"].get("met"))
        f2 = [m["second_opinion"]["findings"] for m in ms if m.get("second_opinion") and m["second_opinion"].get("findings") is not None]
        out.append(f"| {cell} | {len(ms)} | {st.count('ok')} | {st.count('known_gaps')} | {sum(1 for s in st if s not in ('ok', 'known_gaps', 'scheduled'))} | {unmet} | "
                   f"{(sum(passes) / len(passes)):.1f} | {sum(f2) if f2 else '-'} |" if passes else
                   f"| {cell} | {len(ms)} | {st.count('ok')} | {st.count('known_gaps')} | {sum(1 for s in st if s not in ('ok', 'known_gaps', 'scheduled'))} | {unmet} | - | {sum(f2) if f2 else '-'} |")
    by_wf, flags = trend_and_flags(rows)
    out += ["", f"## Scorecard trend (last {args.days} days, oldest to newest per workflow)", "",
            "| Workflow | Run | min | tool calls | credits | TBC | gaps | unmet | link cov | owner edit |", "|---|---|---|---|---|---|---|---|---|---|"]
    for wf, cards in sorted(by_wf.items()):
        for started, c in cards[-args.trend_runs:]:
            v = lambda k: "-" if c.get(k) is None else c.get(k)
            out.append(f"| {wf} | {started.strftime('%m/%d %H:%M')} | {v('minutes_elapsed')} | {v('tool_calls')} | {v('credits')} | {v('tbc_count')} | {v('known_gaps')} | {v('contract_unmet')} | {v('link_coverage')} | {v('owner_edit_ratio')} |")
    if not by_wf:
        out.append("| - | no scorecards in the window | | | | | | | | |")
    out += ["", "## Flags (a field worse two runs in a row)", ""]
    out += [f"- {f}" for f in flags] or ["- none"]
    out += ["", "## Recurring Known Gaps (seen twice or more)", ""]
    rec = [(k, v) for k, v in gaps.items() if v >= 2]
    out += [f"- {v}x: {k}" for k, v in sorted(rec, key=lambda kv: -kv[1])] or ["- none"]
    out += ["", "## Proposed enforcers", "",
            "A gap that recurs is a missing source, a missing rule or a missing check, in that order of preference.",
            "For each line above decide: add a source connector to the workflow (coverage.require_connectors), add a rule to the",
            "writer skill, or add a check to `vstack check`. Record the decision beside the line and keep this page."]
    dest = Path(args.out).expanduser() if args.out else Path(args.ledger_root).expanduser().parent / "retro" / f"{dt.date.today().isoformat()}.md"
    dest.parent.mkdir(parents=True, exist_ok=True)
    dest.write_text("\n".join(out) + "\n")
    print("\n".join(out))
    print(f"\nwritten: {dest}", file=sys.stderr)
    return 0


# ----------------------------------------------------------------------------- record, scorecard, reflect

SCORECARD_FIELDS = ("minutes_elapsed", "tool_calls", "credits", "tbc_count", "known_gaps", "contract_unmet", "link_coverage", "owner_edit_ratio")
LOWER_IS_BETTER = {"minutes_elapsed", "tool_calls", "credits", "tbc_count", "known_gaps", "contract_unmet", "owner_edit_ratio"}


def _table_rows(text):
    """Data rows of every markdown table in text (header and separator rows excluded)."""
    rows = []
    for line in text.splitlines():
        if not line.startswith("|"):
            continue
        cells = [c.strip() for c in line.strip().strip("|").split("|")]
        if all(re.fullmatch(r":?-{3,}:?", c) for c in cells if c) and any(cells):
            continue
        rows.append(line)
    # drop header rows: the row right before a separator
    out, lines = [], text.splitlines()
    for i, line in enumerate(lines):
        if not line.startswith("|"):
            continue
        cells = [c.strip() for c in line.strip().strip("|").split("|")]
        if all(re.fullmatch(r":?-{3,}:?", c) for c in cells if c) and any(cells):
            continue
        nxt = lines[i + 1] if i + 1 < len(lines) else ""
        ncells = [c.strip() for c in nxt.strip().strip("|").split("|")] if nxt.startswith("|") else []
        if ncells and all(re.fullmatch(r":?-{3,}:?", c) for c in ncells if c):
            continue  # header
        out.append(line)
    return out


def scorecard(run_dir, cell=None, meta=None):
    """Engine-computed numbers for one run, the same fields for every workflow (factory decision 2).
    No model call. credits is read from meta.json when a harness wrote it, else null, never 0."""
    run_dir = Path(run_dir)
    meta = meta or (load(run_dir / "meta.json") if (run_dir / "meta.json").exists() else {})
    result = load(run_dir / "result.json") if (run_dir / "result.json").exists() else {}
    draft = (run_dir / "draft.md").read_text() if (run_dir / "draft.md").exists() else ""
    minutes = None
    if meta.get("seconds") is not None:
        minutes = round(float(meta["seconds"]) / 60, 1)
    elif isinstance(result.get("minutes_elapsed"), (int, float)):
        minutes = result["minutes_elapsed"]
    else:
        try:
            files = [f for f in run_dir.iterdir() if f.is_file()]
            t0 = min(f.stat().st_mtime for f in files if f.name == "prompt.md") if (run_dir / "prompt.md").exists() else min(f.stat().st_mtime for f in files)
            t1 = (run_dir / "result.json").stat().st_mtime if (run_dir / "result.json").exists() else max(f.stat().st_mtime for f in files)
            minutes = round(max(0.0, (t1 - t0) / 60), 1)
        except ValueError:
            minutes = None
    tool_calls = meta.get("tool_calls") if isinstance(meta.get("tool_calls"), int) else (result.get("tool_calls") if isinstance(result.get("tool_calls"), int) else None)
    credits = meta.get("credits") if isinstance(meta.get("credits"), (int, float)) else None
    body = "\n".join(l for l in draft.splitlines() if not re.match(r"^\| \d\d/\d\d/\d{4} \d\d:\d\d", l))  # the per-doc status row is not part of the run's section
    tbc = body.count("(TO BE CONFIRMED)")
    gaps = 0
    if "Known Gaps" in body:
        tail = body.rsplit("Known Gaps", 1)[1]
        for l in tail.splitlines()[1:]:
            if l.startswith("- "):
                gaps += 1
            elif l.strip() and not l.startswith("- "):
                break
    unmet = len(verify_contract(run_dir, cell)) if cell else len((meta.get("contract") or {}).get("unmet") or [])
    rows = _table_rows(draft)
    linked = [r for r in rows if re.search(r"\]\(https?://", r) or "roster.json" in r or re.search(r"(standup|review|sync|meeting|notes) \d\d/\d\d", r)]
    coverage = round(len(linked) / len(rows), 3) if rows else None
    prev = load(run_dir / "scorecard.json") if (run_dir / "scorecard.json").exists() else {}
    card = {"run_id": meta.get("run_id") or run_dir.name.split("-", 1)[-1], "workflow": meta.get("workflow") or run_dir.parent.name,
            "harness": meta.get("harness") or run_dir.name.split("-")[0], "computed_at": now(),
            "minutes_elapsed": minutes, "tool_calls": tool_calls, "credits": credits, "tbc_count": tbc, "known_gaps": gaps,
            "contract_unmet": unmet, "link_coverage": coverage, "table_rows": len(rows),
            "owner_edit_ratio": prev.get("owner_edit_ratio"), "owner_edit_ratio_at": prev.get("owner_edit_ratio_at")}
    (run_dir / "scorecard.json").write_text(json.dumps(card, indent=2) + "\n")
    return card


def record_run(run_dir, cell, ledger_root, harness=None, post_record=None):
    """Stage 6 for any harness path. Writes meta.json when the engine did not (a worker followed a rendered
    prompt), computes scorecard.json, appends one runs.jsonl line unless that run_id is already there."""
    run_dir = Path(run_dir).expanduser()
    ledger = Path(ledger_root).expanduser() / "runs.jsonl"
    ledger.parent.mkdir(parents=True, exist_ok=True)
    meta_file = run_dir / "meta.json"
    meta = load(meta_file) if meta_file.exists() else {}
    run_id = meta.get("run_id") or run_dir.name.split("-", 1)[-1]
    harness = meta.get("harness") or harness or run_dir.name.split("-")[0]
    result = load(run_dir / "result.json") if (run_dir / "result.json").exists() else {"status": "failed", "note": "no result.json written"}
    unmet = verify_contract(run_dir, cell) if cell else []
    if unmet and result.get("status") in ("ok", "known_gaps"):
        result["claimed_status"] = result["status"]
        result["status"] = "contract_unmet"
    started = meta.get("started")
    if not started:
        try:
            started = dt.datetime.strptime(run_id[:15], "%Y%m%d-%H%M%S").astimezone(dt.timezone.utc).isoformat().replace("+00:00", "Z")
        except ValueError:
            started = dt.datetime.fromtimestamp(min(f.stat().st_mtime for f in run_dir.iterdir()), dt.timezone.utc).isoformat().replace("+00:00", "Z")
    meta.update({"run_id": run_id, "workflow": (cell or {}).get("id") or meta.get("workflow") or run_dir.parent.name, "harness": harness,
                 "dry_run": meta.get("dry_run", bool(result.get("dry_run", False))), "no_publish": meta.get("no_publish", result.get("mode") == "no-publish"),
                 "started": started, "finished": meta.get("finished") or now(), "run_dir": str(run_dir), "prompt": meta.get("prompt") or str(run_dir / "prompt.md"),
                 "result": result, "contract": {"met": not unmet, "unmet": unmet}, "recorded_by": "vstack record"})
    card = scorecard(run_dir, cell, meta)
    meta["scorecard"] = {k: card.get(k) for k in SCORECARD_FIELDS}
    meta_file.write_text(json.dumps(meta, indent=2))
    seen = set()
    if ledger.exists():
        for line in ledger.read_text().splitlines():
            try:
                seen.add(json.loads(line).get("run_id"))
            except Exception:
                pass
    appended = run_id not in seen
    if appended:
        with open(ledger, "a") as f:
            f.write(json.dumps(meta) + "\n")
    run_post_record(post_record, run_dir)
    return meta, appended


def run_post_record(cmd, run_dir):
    """workflow.record.post_record: an instance command the engine runs after record and after reflect (a
    dashboard render, a mirror copy). Shell-free argv split, 180 s cap, output to post-record.log, never fatal."""
    if not cmd:
        return
    try:
        argv = shlex.split(cmd)
        with open(Path(run_dir) / "post-record.log", "a") as log:
            log.write(f"\n# {now()} {cmd}\n")
            proc = subprocess.run(argv, stdout=log, stderr=subprocess.STDOUT, text=True, timeout=180)
        print(f"post_record: exit {proc.returncode} ({cmd})")
    except Exception as e:
        print(f"post_record: failed to run ({e})", file=sys.stderr)


def record(args):
    run_dir = Path(args.run_dir).expanduser()
    cell = None
    wf = getattr(args, "workflow", None)
    if not wf and getattr(args, "instance", None):
        cand = Path(args.instance).expanduser() / "workflows" / f"{run_dir.parent.name}.json"
        if cand.exists():
            wf = str(cand)
    if wf:
        cell = load(Path(wf).expanduser())
        cell = expand_deep(cell, {"config": cell.get("config", {})})
    post = (cell or {}).get("record", {}).get("post_record") if cell else None
    meta, appended = record_run(run_dir, cell, args.ledger_root, post_record=post)
    print(f"record: {meta['workflow']} {meta['run_id']} status={meta['result'].get('status')} contract={'MET' if meta['contract']['met'] else 'UNMET'} "
          f"runs.jsonl={'appended' if appended else 'already present'} scorecard={json.dumps(meta['scorecard'])}")
    return 0


def runs_from_ledger(ledger_root, days=None):
    ledger = Path(ledger_root).expanduser() / "runs.jsonl"
    rows = []
    if not ledger.exists():
        return rows
    since = dt.datetime.now(dt.timezone.utc) - dt.timedelta(days=days) if days else None
    for line in ledger.read_text().splitlines():
        try:
            m = json.loads(line)
            started = dt.datetime.fromisoformat(m.get("started", "").replace("Z", "+00:00"))
        except Exception:
            continue
        if started.tzinfo is None:
            started = started.replace(tzinfo=dt.timezone.utc)
        if since is None or started >= since:
            m["_started"] = started
            rows.append(m)
    rows.sort(key=lambda m: m["_started"])
    return rows


def trend_and_flags(rows):
    """Per workflow: the scorecard of the last N runs, and a flag for every field worse two runs in a row."""
    by = {}
    for m in rows:
        sc = Path(m.get("run_dir", "")) / "scorecard.json"
        card = load(sc) if sc.exists() else m.get("scorecard")  # the file is newer than the ledger line (reflect fills owner_edit_ratio later)
        if card:
            by.setdefault(m.get("workflow") or m.get("cell") or "?", []).append((m["_started"], card))
    flags = []
    for wf, cards in by.items():
        cards.sort(key=lambda t: t[0])
        for field in SCORECARD_FIELDS:
            vals = [c.get(field) for _, c in cards if isinstance(c.get(field), (int, float))]
            if len(vals) < 3:
                continue
            a, b, c = vals[-3], vals[-2], vals[-1]
            worse = (lambda x, y: y > x) if field in LOWER_IS_BETTER else (lambda x, y: y < x)
            if worse(a, b) and worse(b, c):
                flags.append(f"{wf}: {field} regressed two runs in a row ({a} -> {b} -> {c})")
    return by, flags


def classify_block(before, after):
    """wording | fact | structure | deletion, from two block texts (factory decision 1)."""
    if after is None or not after.strip():
        return "deletion"
    if before is None:
        return "structure"
    nums = lambda t: re.findall(r"\(https?://[^)]+\)|\[CR-\d+\]|\d[\d,./%:-]*", t)  # link targets, CR ids, numbers and dates are facts
    if nums(before) != nums(after):
        return "fact"
    bt, at = before.strip(), after.strip()
    if bt.startswith("|") != at.startswith("|") or bt.startswith("#") != at.startswith("#") or bt.count("\n") != at.count("\n") or len(bt.split("|")) != len(at.split("|")):
        return "structure"
    return "wording"


def _blocks(text):
    """Markdown text to a list of blocks: a table is one block, a heading one block, a list one block, a paragraph one block."""
    blocks, cur, kind = [], [], None
    for line in text.splitlines():
        k = "table" if line.startswith("|") else "list" if re.match(r"^\s*[-*] ", line) else "heading" if line.startswith("#") else "blank" if not line.strip() else "para"
        if k == "blank" or (cur and k != kind) or k == "heading":
            if cur:
                blocks.append("\n".join(cur))
            cur = [] if k == "blank" else [line]
            kind = None if k == "blank" else k
            if k == "heading":
                blocks.append(line); cur = []; kind = None
            continue
        cur.append(line); kind = k
    if cur:
        blocks.append("\n".join(cur))
    return [b for b in blocks if b.strip() and not b.startswith("Sources:")]


def _norm(b):
    """Comparison form of a block: bold markers and heading depth are rendering, not content (Chorus stores
    `**[t](u)**` as `[**t**](u)` and demotes section sub-headings), separator rows and whitespace collapse."""
    t = b.replace("**", "")
    t = re.sub(r"^#+\s*", "", t, flags=re.M)
    t = re.sub(r"^\|(\s*:?-{3,}:?\s*\|)+\s*$", "|---|", t, flags=re.M)
    return re.sub(r"\s+", " ", t).strip()


def reflect_diff(draft_text, landed_text):
    """Pair draft blocks with landed blocks (same normalised text, else best match by table-row key or position) and classify."""
    import difflib
    d, l = _blocks(draft_text), _blocks(landed_text)
    dn, ln = [_norm(b) for b in d], [_norm(b) for b in l]
    changes, matched_l = [], set()
    for i, (b, nb) in enumerate(zip(d, dn)):
        if nb in ln:
            j = ln.index(nb)
            matched_l.add(j)
            continue
        # a table: compare row by row on the first two cells
        if b.startswith("|"):
            cand = [j for j, lb in enumerate(l) if lb.startswith("|") and j not in matched_l]
            best = max(cand, key=lambda j: difflib.SequenceMatcher(None, nb, ln[j]).ratio(), default=None)
            if best is not None and difflib.SequenceMatcher(None, nb, ln[best]).ratio() > 0.5:
                matched_l.add(best)
                drows = {r.split("|")[1].strip() + "|" + (r.split("|")[2].strip() if r.count("|") > 2 else ""): r for r in _table_rows(b)}
                lrows = {r.split("|")[1].strip() + "|" + (r.split("|")[2].strip() if r.count("|") > 2 else ""): r for r in _table_rows(l[best])}
                for key, dr in drows.items():
                    lr = lrows.get(key)
                    if lr is None:
                        changes.append({"block": i, "kind": "deletion", "before": dr, "after": None})
                    elif _norm(lr) != _norm(dr):
                        changes.append({"block": i, "kind": classify_block(dr, lr), "before": dr, "after": lr})
                for key, lr in lrows.items():
                    if key not in drows:
                        changes.append({"block": i, "kind": "structure", "before": None, "after": lr})
                continue
        cand = [j for j in range(len(l)) if j not in matched_l]
        best = max(cand, key=lambda j: difflib.SequenceMatcher(None, nb, ln[j]).ratio(), default=None)
        if best is not None and difflib.SequenceMatcher(None, nb, ln[best]).ratio() > 0.6:
            matched_l.add(best)
            changes.append({"block": i, "kind": classify_block(b, l[best]), "before": b, "after": l[best]})
        else:
            changes.append({"block": i, "kind": "deletion", "before": b, "after": None})
    for j, lb in enumerate(l):
        if j not in matched_l:
            changes.append({"block": None, "kind": "structure", "before": None, "after": lb})
    draft_chars = sum(len(b) for b in d) or 1
    changed_chars = 0
    for c in changes:
        a, b = c.get("before") or "", c.get("after") or ""
        sm = difflib.SequenceMatcher(None, a, b)
        changed_chars += sum(max(i2 - i1, j2 - j1) for tag, i1, i2, j1, j2 in sm.get_opcodes() if tag != "equal")
    return {"draft_blocks": len(d), "landed_blocks": len(l), "changes": changes, "owner_edit_ratio": round(min(1.0, changed_chars / draft_chars), 4)}


def _proposed_regex(before, after):
    """A must_not_match candidate from an edit: the longest run of words the owner removed or replaced,
    as an escaped regex with flexible whitespace. None when the change is under two words and eight characters."""
    import difflib
    bw, aw = (before or "").split(), (after or "").split()
    sm = difflib.SequenceMatcher(None, bw, aw)
    runs = [bw[i1:i2] for tag, i1, i2, j1, j2 in sm.get_opcodes() if tag in ("replace", "delete") and i2 > i1]
    runs = [r for r in runs if len(r) >= 2 or len(" ".join(r)) >= 8]
    if not runs:
        return None
    run = max(runs, key=lambda r: len(" ".join(r)))[:12]
    return r"\s+".join(re.escape(w) for w in run)


REFLECT_PROMPT = """# vstack reflect ({harness}): read back a landed document, write nothing to it

Run directory: {run_dir}. The run landed its draft in a Chorus document. Read it back with the
chorus-mcp read tool (ChorusDocRead action=read, doc_id below) and write the landed SECTION, not the
whole doc, as markdown to {landed_file}: every block in document order, tables as markdown tables with
one line per row, lists as `- ` lines, headings as `#` lines, one blank line between blocks. Keep the
block ids and hashes as HTML comments on the line before each block, exactly as the read returns them.
The section starts at the heading whose text equals the draft's section heading (the first `## ` line in
{run_dir}/draft.md) and ends before the next heading of the same level or the About heading.

Doc id: {doc_id}
Section heading to find: {heading}

Never edit, comment on, share or delete anything. When the doc cannot be read (no chorus-mcp, stale
token), write {landed_file} with the single line `UNREADABLE: <reason>` and stop.
Then run with your shell: `{vstack_bin} reflect {run_dir} --age {age} --instance {instance}`
Reply with the single line: VSTACK_REFLECT {age} done
"""


def reflect(args):
    """Stage 7. --render prints the worker prompt that writes landed-<age>.md. Without it, diff
    landed-<age>.md against draft.md, write reflect-<age>.json, fill owner_edit_ratio, file proposals."""
    inst = Path(args.instance).expanduser() if args.instance else None
    ledger_root = Path(args.ledger_root).expanduser()
    if args.due:
        due = []
        nowt = dt.datetime.now(dt.timezone.utc)
        for m in runs_from_ledger(ledger_root, days=10):
            rd = Path(m.get("run_dir", ""))
            if not rd.exists() or m.get("dry_run") or m.get("no_publish"):
                continue
            landed = (m.get("result") or {}).get("landed")
            if not (isinstance(landed, dict) and (landed.get("chorus") or landed.get("doc_id"))):
                continue
            age_h = (nowt - m["_started"]).total_seconds() / 3600
            for age, lo, hi in (("24h", 24, 7 * 24), ("7d", 7 * 24, 10 * 24)):
                if lo <= age_h < hi and not (rd / f"reflect-{age}.json").exists():
                    due.append((str(rd), age))
        for rd, age in due:
            print(f"{rd} --age {age}")
        if not due:
            print("reflect --due: nothing due", file=sys.stderr)
        return 0
    run_dir = Path(args.run_dir).expanduser()
    age = args.age
    landed_file = run_dir / f"landed-{age}.md"
    result = load(run_dir / "result.json") if (run_dir / "result.json").exists() else {}
    landed = result.get("landed") or {}
    doc_id = (landed.get("chorus") or {}).get("doc_id") if isinstance(landed, dict) else None
    doc_id = doc_id or (landed.get("doc_id") if isinstance(landed, dict) else None) or args.doc_id
    draft = (run_dir / "draft.md").read_text() if (run_dir / "draft.md").exists() else ""
    heading = next((l for l in draft.splitlines() if l.startswith("## ")), "")
    workflow = run_dir.parent.name
    if args.render:
        if not doc_id:
            die(f"{run_dir}: no Chorus doc id in result.json landed, pass --doc-id")
        prompt = REFLECT_PROMPT.format(harness=args.harness, run_dir=run_dir, landed_file=landed_file, doc_id=doc_id, heading=heading,
                                       vstack_bin=str(HERE / "bin/vstack"), age=age, instance=inst or "")
        (run_dir / f"prompt-reflect-{age}.md").write_text(prompt)
        print(prompt)
        return 0
    if not landed_file.exists():
        die(f"{landed_file} missing: run `vstack reflect {run_dir} --age {age} --render` and hand the prompt to a worker first")
    landed_text = landed_file.read_text()
    if landed_text.startswith("UNREADABLE"):
        out = {"age": age, "doc_id": doc_id, "status": "unreadable", "note": landed_text.strip(), "computed_at": now()}
        (run_dir / f"reflect-{age}.json").write_text(json.dumps(out, indent=2) + "\n")
        print(json.dumps(out)); return 0
    # the draft section: from the first ## heading to Known Gaps inclusive (the status table is per doc, not per run)
    sec = draft.split(heading, 1)[1] if heading and heading in draft else draft
    sec = heading + sec
    landed_clean = "\n".join(l for l in landed_text.splitlines() if not l.startswith("<!--"))
    diff = reflect_diff(sec, landed_clean)
    out = {"age": age, "doc_id": doc_id, "status": "ok", "computed_at": now(), "heading": heading, **diff,
           "counts": {k: sum(1 for c in diff["changes"] if c["kind"] == k) for k in ("wording", "fact", "structure", "deletion")}}
    (run_dir / f"reflect-{age}.json").write_text(json.dumps(out, indent=2) + "\n")
    # scorecard: owner_edit_ratio
    sc = run_dir / "scorecard.json"
    card = load(sc) if sc.exists() else scorecard(run_dir)
    card["owner_edit_ratio"] = diff["owner_edit_ratio"]; card["owner_edit_ratio_at"] = age
    sc.write_text(json.dumps(card, indent=2) + "\n")
    # ledger: update the runs.jsonl line's scorecard in place is append-only, so append a reflect line to a sibling ledger
    ledger_root.mkdir(parents=True, exist_ok=True)
    with open(ledger_root / "reflect.jsonl", "a") as f:
        f.write(json.dumps({"run_id": card.get("run_id"), "workflow": workflow, "age": age, "owner_edit_ratio": diff["owner_edit_ratio"], **out["counts"], "at": now()}) + "\n")
    # file the changes into the instance context (private)
    filed = {"proposals": 0, "mistakes": 0, "deletions": 0, "auto_applied": []}
    if inst and diff["changes"]:
        ctx = inst / "context" / workflow
        if not ctx.exists():  # workflows that share a context folder (people-pulse-daily -> context/people-pulse)
            cands = [d for d in (inst / "context").iterdir() if d.is_dir() and workflow.startswith(d.name)] if (inst / "context").exists() else []
            if cands:
                ctx = max(cands, key=lambda d: len(d.name))
        ctx.mkdir(parents=True, exist_ok=True)
        today = dt.date.today().strftime("%m/%d/%Y")
        props = ctx / "proposals.md"
        if not props.exists():
            props.write_text(f"# {workflow}: proposed contract rules from reflect\n\nOne row per wording or structure change found in a landed document (factory decision 1). Status proposed until Vikash accepts it or the same regex appears twice, then applied.\n\n| # | Date | Run | Before | After | Proposed regex | Status |\n|---|---|---|---|---|---|---|\n")
        existing = props.read_text()
        n = len(re.findall(r"^\| \d+ \|", existing, re.M))
        regex_seen = {}
        for m in re.finditer(r"^\| (\d+) \| .*\| `([^`]*)` \| (\w+) \|$", existing, re.M):
            regex_seen.setdefault(m.group(2).strip(), []).append((int(m.group(1)), m.group(3)))
        rows = []
        for c in diff["changes"]:
            cell_ = lambda t: (t or "").replace("|", "\\|").replace("\n", " ")[:140]
            if c["kind"] in ("wording", "structure") and c.get("before"):
                rx = _proposed_regex(c["before"], c["after"]) or ""
                n += 1
                status = "proposed"
                prior = [p for p in regex_seen.get(rx, []) if p[1] == "proposed"]
                if rx and prior:
                    status = "applied"
                    filed["auto_applied"].append((rx, n, prior[0][0]))
                rows.append(f"| {n} | {today} | {card.get('run_id')} {age} | {cell_(c['before'])} | {cell_(c['after'])} | `{rx}` | {status} |")
                regex_seen.setdefault(rx, []).append((n, status))
                filed["proposals"] += 1
            elif c["kind"] == "fact":
                mist = ctx / "mistakes.md"
                if not mist.exists():
                    mist.write_text(f"# {workflow}: mistakes log\n\n| Date | Source | What was wrong | Rule now |\n|---|---|---|---|\n")
                with open(mist, "a") as f:
                    f.write(f"| {today} | reflect {age} on run {card.get('run_id')} | landed text changed a fact: {cell_(c['before'])} became {cell_(c['after'])} | every number, date and link is read from evidence.json, never typed. Check the source this one came from |\n")
                filed["mistakes"] += 1
            elif c["kind"] == "deletion" and c.get("before"):
                dj = ctx / "deletions.json"
                dels = load(dj) if dj.exists() else {}
                first = c["before"].splitlines()[0]
                cells_ = [x.strip() for x in first.strip().strip("|").split("|")] if first.startswith("|") else []
                key = (" | ".join(x for x in cells_ if x and not re.fullmatch(r"\d+|L\d", x))[:80] if cells_ else first.strip("# ")[:80])
                dels[key] = dels.get(key, 0) + 1
                dj.write_text(json.dumps(dels, indent=2) + "\n")
                filed["deletions"] += 1
                if dels[key] == 3:
                    wf_file = inst / "workflows" / f"{workflow}.json"
                    if wf_file.exists():
                        w = load(wf_file)
                        w.setdefault("writer", {}).setdefault("extra_inputs", []).append(f"do not write section {key} (deleted by the owner in three landed documents, reflect {today})")
                        wf_file.write_text(json.dumps(w, indent=2, ensure_ascii=False) + "\n")
        if rows:
            with open(props, "a") as f:
                f.write("\n".join(rows) + "\n")
        # auto-apply: the identical regex proposed twice goes into draft_contract.must_not_match
        if filed["auto_applied"]:
            wf_file = inst / "workflows" / f"{workflow}.json"
            if wf_file.exists():
                w = load(wf_file)
                mnm = w.setdefault("draft_contract", {}).setdefault("must_not_match", [])
                for rx, n_new, n_old in filed["auto_applied"]:
                    if not any(r.get("pattern") == rx for r in mnm):
                        mnm.append({"pattern": rx, "why": f"auto-applied after 2 repeats, proposals.md #{n_old} and #{n_new}"})
                wf_file.write_text(json.dumps(w, indent=2, ensure_ascii=False) + "\n")
                text = props.read_text()
                for rx, n_new, n_old in filed["auto_applied"]:
                    text = re.sub(rf"^(\| {n_old} \| .*\| `{re.escape(rx)}` \| )proposed \|$", r"\1applied |", text, flags=re.M)
                props.write_text(text)
    out["filed"] = filed
    print(json.dumps({k: out[k] for k in ("age", "status", "draft_blocks", "landed_blocks", "owner_edit_ratio", "counts", "filed")}))
    post = None
    if inst:
        wf_file = inst / "workflows" / f"{workflow}.json"
        if wf_file.exists():
            post = (load(wf_file).get("record") or {}).get("post_record")
    run_post_record(post, run_dir)
    return 0


# ----------------------------------------------------------------------------- generators
def gen_cron(args):
    out = []
    for p in sorted(Path(args.workflows).glob("*.json")):
        if p.name.endswith(".sample.json"):
            continue
        c = load(p)
        trig = c.get("trigger", {})
        if not trig.get("cron"):
            continue
        base = f"{args.vstack_bin} run {p.resolve()} --harness {args.harness} --tools {args.tools}"
        if args.org_profile:
            base += f" --glossary {args.org_profile}"
        if args.harness == "kirocrew":
            # The Kiro Crew agent is the harness: the job's message tells it to render the cell with
            # its shell (fresh run dir and ids every time) and then execute the printed prompt itself.
            render_cmd = base.replace(" run ", " render ", 1)
            msg = f"Run this command with your shell tool and then follow the prompt it prints, stage by stage, exactly: {render_cmd}"
            out.append(f"kirocrew cron add {shlex.quote(c['id'])} {shlex.quote(msg)} "
                       f"--cron {shlex.quote(trig['cron'])} --timezone {shlex.quote(trig.get('timezone', 'UTC'))} --approval-mode auto"
                       + (f"   # bind to bot {c['bot']} on the Schedule page" if c.get("bot") else ""))
        else:
            tz = trig.get("timezone")
            out.append((f"CRON_TZ={tz} " if tz else "") + f"{trig['cron']} {base} >> {args.log_dir}/{c['id']}.log 2>&1")
    print("\n".join(out))


def gen_mcp(args):
    servers = load(args.servers)["servers"]
    if args.target == "codex":
        for name, s in servers.items():
            print(f"[mcp_servers.{name}]\ncommand = \"{s['command']}\"\nargs = {json.dumps(s.get('args', []))}")
            if s.get("env"):
                print(f"[mcp_servers.{name}.env]")
                for k, v in s["env"].items():
                    print(f"{k} = \"{v}\"")
            print()
    elif args.target in ("claude", "kiro", "kirocrew"):
        block = {name: {"command": s["command"], "args": s.get("args", []), **({"env": s["env"]} if s.get("env") else {})} for name, s in servers.items()}
        print(json.dumps({"mcpServers": block}, indent=2))
    else:
        die("target must be codex|claude|kiro|kirocrew")


def gen_agent(args):
    """A Kiro CLI agent template whose MCP servers are exactly the ones the connectors file names and
    whose trusted tools are the read-only ones, so a workflow run cannot reach anything else."""
    conns = load(args.tools).get("connectors", load(args.tools).get("roles", {}))
    servers = sorted({v["server"] for v in conns.values() if v.get("server") and v["server"] != "local-shell"})
    read_tools = sorted({f"@{v['server']}/{v['tool']}" for v in conns.values()
                         if v.get("server") not in (None, "local-shell") and re.search(r"read|get|list|search|view|lookup|describe|health", v["tool"], re.I)})
    agent = {
        "name": args.name,
        "description": "vstack workflow runner: read-only MCP tools during gather, one write at the sink, shell for local scripts",
        "mcpServers": {sv: {"command": sv} for sv in servers},
        "tools": ["fs_read", "fs_write", "execute_bash"] + [f"@{sv}" for sv in servers],
        "allowedTools": ["fs_read", "fs_write"] + read_tools,
        "resources": [],
    }
    print(json.dumps(agent, indent=2))


# ----------------------------------------------------------------------------- main
def main():
    ap = argparse.ArgumentParser(prog="vstack", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="cmd", required=True)

    def common(sp):
        sp.add_argument("--instance", help="instance directory; fills --connectors and --glossary from it and checks vstack.lock (default: $VSTACK_INSTANCE)")
        sp.add_argument("--connectors", "--tools", dest="tools", help="connectors.json mapping connector names to MCP tools")
        sp.add_argument("--glossary", "--org-profile", dest="org_profile", help="glossary markdown: the company's words passed to the writer")
        sp.add_argument("--skills-dir", default=str(HOME / ".agents/skills"))
        sp.add_argument("--extra-skill-dirs", nargs="*", default=[], help="other harness skill dirs that must match")
        sp.add_argument("--skills-lock", help="skills-lock.json from npx skills")
        sp.add_argument("--private-component", default=PRIVATE_COMPONENT_DEFAULT)
        sp.add_argument("--run-root", default=str(HOME / ".local/state/vstack/runs"))
        sp.add_argument("--cache-root", default=str(HOME / ".local/state/vstack/cache"))
        sp.add_argument("--ledger-root", default=str(HOME / ".local/state/vstack/ledger"))
        sp.add_argument("--sample", "--fixture", dest="fixture", help="sample evidence file to use instead of live sources (default: <workflow>.sample.json beside the workflow)")
        sp.add_argument("--dry-run", action="store_true", help="sample evidence in, file out, no publishing")
        sp.add_argument("--no-publish", action="store_true", help="live gather and gate, but the draft lands as a file; nothing is posted, drafted or sent")

    sp = sub.add_parser("render"); common(sp); sp.add_argument("cell", metavar="workflow"); sp.add_argument("--harness", choices=HARNESSES, default="print", help="name shown in the prompt header; render never executes")
    sp = sub.add_parser("run"); common(sp); sp.add_argument("cell", metavar="workflow"); sp.add_argument("--harness", choices=HARNESSES, required=True)
    sp.add_argument("--agent", help="agent template (kiro) or Bot name (kirocrew)")
    sp.add_argument("--model")
    sp.add_argument("--second-opinion", choices=("claude", "codex", "kiro"), help="run an independent critic on this harness after the gate; findings are recorded, never block")
    sp.add_argument("--timeout", type=int, default=1500)
    sp = sub.add_parser("check-run"); sp.add_argument("run_dir"); sp.add_argument("--min-passes", type=int, default=2); sp.add_argument("--workflow", help="workflow JSON whose gate and draft_contract apply"); sp.add_argument("--instance", default=os.environ.get("VSTACK_INSTANCE"), help="instance directory (default: $VSTACK_INSTANCE); resolves workflows/<run parent name>.json")
    sp = sub.add_parser("retro"); sp.add_argument("--days", type=int, default=7); sp.add_argument("--out"); sp.add_argument("--ledger-root", default=str(HOME / ".local/state/vstack/ledger")); sp.add_argument("--trend-runs", type=int, default=8, help="scorecards per workflow in the trend table")
    sp = sub.add_parser("record"); sp.add_argument("run_dir"); sp.add_argument("--workflow", help="workflow JSON whose contract applies"); sp.add_argument("--instance", default=os.environ.get("VSTACK_INSTANCE")); sp.add_argument("--ledger-root", default=str(HOME / ".local/state/vstack/ledger"))
    sp = sub.add_parser("reflect"); sp.add_argument("run_dir", nargs="?"); sp.add_argument("--age", choices=("24h", "7d"), default="24h"); sp.add_argument("--render", action="store_true", help="print the worker prompt that writes landed-<age>.md")
    sp.add_argument("--due", action="store_true", help="list `<run_dir> --age <age>` for every landed run 24 h or 7 d old without that reflect"); sp.add_argument("--doc-id"); sp.add_argument("--harness", choices=HARNESSES, default="kirocrew")
    sp.add_argument("--instance", default=os.environ.get("VSTACK_INSTANCE")); sp.add_argument("--ledger-root", default=str(HOME / ".local/state/vstack/ledger"))
    sp = sub.add_parser("check"); sp.add_argument("--instance", help="instance directory (default: $VSTACK_INSTANCE); fills --workflows"); sp.add_argument("--workflows", "--cells", dest="workflows"); sp.add_argument("--private-component", default=PRIVATE_COMPONENT_DEFAULT)
    sp = sub.add_parser("map"); sp.add_argument("--instance", help="instance directory (default: $VSTACK_INSTANCE)"); sp.add_argument("--workflows", "--cells", dest="workflows"); sp.add_argument("--json", action="store_true")
    sp = sub.add_parser("gen-agent"); sp.add_argument("--instance", help="instance directory (default: $VSTACK_INSTANCE)"); sp.add_argument("--connectors", "--tools", dest="tools"); sp.add_argument("--harness", choices=("kiro",), required=True); sp.add_argument("--name", default="vstack-runner")
    sp = sub.add_parser("verify-skills"); sp.add_argument("--lock"); sp.add_argument("--dirs", nargs="+", required=True); sp.add_argument("--skills", nargs="+", required=True)
    sp = sub.add_parser("link-skills"); sp.add_argument("--canonical", required=True); sp.add_argument("--targets", nargs="+", required=True)
    sp.add_argument("--skills", nargs="+", required=True); sp.add_argument("--backup", default=str(HOME / ".local/state/vstack/skill-backups"))
    sp = sub.add_parser("gen-cron"); sp.add_argument("--workflows", "--cells", dest="workflows"); sp.add_argument("--harness", choices=HARNESSES, required=True)
    sp.add_argument("--instance", help="instance directory; fills --connectors, --glossary and --workflows (default: $VSTACK_INSTANCE)")
    sp.add_argument("--connectors", "--tools", dest="tools"); sp.add_argument("--glossary", "--org-profile", dest="org_profile"); sp.add_argument("--vstack-bin", default=str(HERE / "bin/vstack")); sp.add_argument("--log-dir", default=str(HOME / ".local/state/vstack/logs"))
    sp = sub.add_parser("gen-mcp"); sp.add_argument("--servers", required=True); sp.add_argument("--target", required=True)
    args = ap.parse_args()

    if args.cmd in ("check", "map"):
        args.tools = None; args.org_profile = None
        apply_instance(args)
        inst = args.instance or os.environ.get("VSTACK_INSTANCE")
        if not args.workflows and inst:
            args.workflows = str(Path(inst).expanduser() / "workflows")
        if not args.workflows:
            die(f"{args.cmd} needs --workflows or --instance")
    if args.cmd == "map":
        _, cells = check(args.workflows, PRIVATE_COMPONENT_DEFAULT)
        m = derive_map(cells)
        print(json.dumps(m, indent=2)) if args.json else print_map(m)
        return
    if args.cmd == "gen-agent":
        args.org_profile = None
        apply_instance(args)
        if not args.tools:
            die("gen-agent needs --connectors or --instance")
        return gen_agent(args)
    if args.cmd == "check":
        fails, cells = check(args.workflows, args.private_component)
        print(f"workflows: {len(cells)}")
        for f in fails:
            print("  FAIL", f)
        print("invariants:", "PASS" if not fails else f"{len(fails)} failure(s)")
        sys.exit(1 if fails else 0)
    if args.cmd == "verify-skills":
        fails, report = verify_skills(args.lock, args.dirs, args.skills)
        for r in report:
            print(" ", r)
        for f in fails:
            print("  FAIL", f)
        print("skills:", "PASS" if not fails else f"{len(fails)} failure(s)")
        sys.exit(1 if fails else 0)
    if args.cmd == "link-skills":
        for line in link_skills(args.canonical, args.targets, args.skills, args.backup):
            print(" ", line)
        return
    if args.cmd == "gen-cron":
        apply_instance(args)
        inst = args.instance or os.environ.get("VSTACK_INSTANCE")
        if not args.workflows and inst:
            args.workflows = str(Path(inst).expanduser() / "workflows")
        if not args.tools or not args.workflows:
            die("gen-cron needs --connectors and --workflows, or --instance")
        return gen_cron(args)
    if args.cmd == "gen-mcp":
        return gen_mcp(args)
    if args.cmd == "check-run":
        sys.exit(check_run(args))
    if args.cmd == "retro":
        sys.exit(retro(args))
    if args.cmd == "record":
        sys.exit(record(args))
    if args.cmd == "reflect":
        if not args.due and not args.run_dir:
            die("reflect needs a run_dir or --due")
        sys.exit(reflect(args))
    if args.cmd in ("render", "run"):
        if args.cmd == "render":
            args.agent = None; args.model = None; args.timeout = 0; args.second_opinion = None
        sys.exit(run(args))


if __name__ == "__main__":
    main()
