{
  "id": "program-update",
  "kind": "writer",
  "component": "program",
  "trigger": {
    "cron": "29 8 * * 1-5",
    "timezone": "UTC",
    "events": []
  },
  "sources": [
    {
      "ref": "${config.statusDocId}",
      "notes": "the running program status document, latest dated entries",
      "connector": "docs.read"
    },
    {
      "ref": "${config.taskProject}",
      "notes": "stories with owner, due date, status, last comment",
      "connector": "tasks.list"
    },
    {
      "ref": "${config.meetingSummaryQuery}",
      "notes": "meeting summary emails from the last ${config.lookbackDays} days",
      "connector": "mail.search"
    },
    {
      "ref": "${config.discussChannel}",
      "notes": "status and blocker messages, last ${config.lookbackDays} days",
      "connector": "chat.search"
    }
  ],
  "cache": {
    "key": "program/${config.program}",
    "ttl_hours": 20
  },
  "writer": {
    "skill": "write-exec-update"
  },
  "gate": {
    "skill": "validate-writing",
    "doc_type": "exec-update",
    "min_passes": 2,
    "max_passes": 5,
    "coverage_bar": 85
  },
  "sink": {
    "ref": "${config.postChannel}",
    "dry_run_path": "update.md",
    "connector": "chat.draft"
  },
  "ledger": {
    "file": "program-update.jsonl",
    "fields": [
      "program",
      "overall_status",
      "red_sections",
      "green_by_dates",
      "open_action_items",
      "posted_to"
    ]
  },
  "config": {
    "program": "Project Lantern",
    "statusDocId": "doc-0000",
    "taskProject": "project-0000",
    "meetingSummaryQuery": "\"Meeting summary\" Lantern",
    "discussChannel": "#lantern",
    "postChannel": "#lantern-leadership",
    "lookbackDays": 14
  },
  "bot": "ProgramStatus",
  "coverage": {
    "min_sources": 3
  }
}
