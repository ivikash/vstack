{
  "id": "program-update",
  "kind": "writer",
  "component": "program",
  "trigger": {"cron": "29 8 * * 1-5", "timezone": "UTC", "events": []},
  "sources": [
    {"role": "docs.read", "ref": "${config.statusDocId}", "notes": "the running program status document, latest dated entries"},
    {"role": "tasks.list", "ref": "${config.taskProject}", "notes": "stories with owner, due date, status, last comment"},
    {"role": "mail.search", "ref": "${config.meetingSummaryQuery}", "notes": "meeting summary emails from the last ${config.lookbackDays} days"},
    {"role": "chat.search", "ref": "${config.discussChannel}", "notes": "status and blocker messages, last ${config.lookbackDays} days"}
  ],
  "cache": {"key": "program/${config.program}", "ttl_hours": 20},
  "writer": {"skill": "write-exec-update"},
  "gate": {"skill": "validate-writing", "doc_type": "exec-update", "min_passes": 2, "max_passes": 5, "coverage_bar": 85},
  "sink": {"role": "chat.draft", "ref": "${config.postChannel}", "dry_run_path": "update.md"},
  "ledger": {"file": "program-update.jsonl", "fields": ["program", "overall_status", "red_sections", "green_by_dates", "open_action_items", "posted_to"]},
  "fixture": "../fixtures/program-update.json",
  "config": {
    "program": "Project Lantern",
    "statusDocId": "doc-0000",
    "taskProject": "project-0000",
    "meetingSummaryQuery": "\"Meeting summary\" Lantern",
    "discussChannel": "#lantern",
    "postChannel": "#lantern-leadership",
    "lookbackDays": 14
  }
}
